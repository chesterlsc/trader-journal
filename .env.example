# Trader Journal — environment variable names only.
#
# PLACEHOLDER NAMES, NO VALUES. Never commit a filled-in copy of this file.
# Set the real values in the Vercel dashboard:
#   Project -> Settings -> Environment Variables
#
# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string for the existing Railway database.
# Use Railway's PUBLIC url (the *.proxy.rlwy.net one). The private
# *.railway.internal host only resolves inside Railway's network and is
# unreachable from a Vercel function.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# HMAC key that signs the session cookie. Any long random string.
# If unset, a key is derived from DATABASE_URL — the app still works, but
# rotating the database URL would then log everyone out.
SESSION_SECRET=

# Canonical origin used to build password-reset links.
# Falls back to the Vercel deployment URL, then the request Host header.
APP_URL=

# ---------------------------------------------------------------------------
# Optional — password reset email (Resend). Without both of these, reset links
# are created but no email is sent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# ---------------------------------------------------------------------------
# Optional — admin views (login_logs, users_admin)
# ---------------------------------------------------------------------------

# Comma-separated usernames allowed into the admin views.
ADMIN_USERNAMES=
# Single-name alternative, used only when ADMIN_USERNAMES is empty.
ADMIN_USERNAME=
# Set to 1/true/yes to fall back to "first registered user is admin" when
# neither variable above is set. Off by default.
ALLOW_BOOTSTRAP_ADMIN=

# ---------------------------------------------------------------------------
# Optional — landing page trade tape (public_recent_trades)
# ---------------------------------------------------------------------------

# Whose trades feed the public tape. Id wins if both are set; leaving both
# empty makes the endpoint return an empty list.
PUBLIC_RECENT_TRADES_USER_ID=
PUBLIC_RECENT_TRADES_USERNAME=

# ---------------------------------------------------------------------------
# Optional — database TLS
# ---------------------------------------------------------------------------

# disable | prefer | require | verify-ca | verify-full
# Defaults to encrypted-without-chain-verification, matching libpq's "prefer",
# which is what the PHP handler used.
PGSSLMODE=
