data/
*.log
.DS_Store
node_modules/
.vercel/

# Real secrets never get committed — .env.example holds the names only.
.env
.env.*
!.env.example
tools/node/
tools/php/
tools/*.zip

# Avoid committing accidental local key/test files.
ssh-keygen -t ed25519 -C "your_email@example.com"
ssh-keygen -t ed25519 -C "your_email@example.com".pub
.claude/
